# Supabase (auth, database, storage, realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI speech generation (server-only; never prefix these with NEXT_PUBLIC_)
OPENAI_API_KEY=
# Optional model override. Defaults to a pinned GPT-4o mini TTS snapshot.
OPENAI_TTS_MODEL=

# Public site URL — used to build links inside emails and push notifications.
# Should be the app's real production domain (not a vercel.app preview URL).
# Supabase Auth's Site URL and allowed redirect URLs must include this origin.
NEXT_PUBLIC_SITE_URL=https://app.lostandfoundproject.org

# Emmaus unified identity handoff. Configure the SAME high-entropy secret in
# the L&F and Emmaus deployments. It signs short-lived assertions only; no
# password or Supabase session token is sent between applications.
EMMAUS_SSO_SECRET=
EMMAUS_SITE_URL=https://emmaus.lostandfoundproject.org

# Google Meet provisioning uses Vercel OIDC + Google Workload Identity
# Federation. No Google private key is stored in Vercel. VERCEL_OIDC_TOKEN is
# injected automatically by Vercel when OIDC Federation is enabled.
# These non-secret values are optional overrides; production defaults are
# already pinned in lib/google-meet/server.ts for the L&F deployment.
GOOGLE_MEET_SERVICE_ACCOUNT_EMAIL=lf-meet-provisioner@the-lost-and-found-project.iam.gserviceaccount.com
GOOGLE_MEET_DELEGATED_ORGANIZER=meetings@lostandfoundproject.org
GOOGLE_MEET_WORKLOAD_IDENTITY_PROVIDER=projects/66404996772/locations/global/workloadIdentityPools/vercel/providers/vercel

# Resend (transactional email: welcome, assignment, digest, moderation, etc.)
RESEND_API_KEY=

# Cloudflare Turnstile (CAPTCHA on public signup / prayer submission forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web push notifications (VAPID keypair — generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lostandfoundproject.org

# Shared secret for internal server-to-server calls (e.g. auth confirmation
# trigger calling the welcome-email route). In production this is stored in
# Supabase Vault, not as a plain env var — only needed here for local dev.
INTERNAL_API_SECRET=

# Protects the Vercel Cron endpoints (weekly digest, stale-assignment nudges,
# rotation auto-pause) from being triggered by anyone who finds the URL.
CRON_SECRET=
